#compdef helm-publish
# zsh completion for helm-publish.
#
# Install (either works):
#   1. Copy onto $fpath as `_helm-publish` (done by `make install-completions`),
#      then ensure the directory is in fpath before compinit runs.
#   2. Source this file directly from .zshrc (after compinit).

_helm_publish_charts() {
  local f
  f="$(_helm_publish_config)"
  [[ -z "$f" ]] && return
  local -a charts
  # helm-publish discovers from project.helm.charts[] or tiers[].charts[].
  charts=(${(f)"$(yq '.tiers[].charts[]' "$f" 2>/dev/null)"})
  _describe -t charts 'chart' charts
}

# Walk up from $PWD to find .infra-config.yaml at the repo root.
_helm_publish_config() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.infra-config.yaml" ]]; then
      echo "$dir/.infra-config.yaml"
      return
    fi
    dir="$(dirname "$dir")"
  done
}

_helm-publish() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  _arguments -C \
    '--list[list all discoverable charts with versions]' \
    '--pick[interactive multi-select picker]' \
    '--all[publish all discovered charts]' \
    '--dry-run[package only, do not push]' \
    '--bump=[increment version]:level:(patch minor major)' \
    '--force[overwrite existing version without confirmation]' \
    '(-y --yes)'{-y,--yes}'[auto-confirm all prompts]' \
    '(-v --verbose)'{-v,--verbose}'[show full helm command output]' \
    '--config=[alternate k8-lib config file]:config:_files' \
    '-h[show help]' \
    '--help[show help]' \
    '1:chart:_helm_publish_charts' && ret=0

  return ret
}

# Dual-mode: autoloaded from fpath (#compdef) vs sourced from .zshrc.
if [[ "${funcstack[1]}" == "_helm-publish" ]]; then
  _helm-publish "$@"
elif (( ${+functions[compdef]} )); then
  compdef _helm-publish helm-publish
fi
