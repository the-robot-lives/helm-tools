#compdef helm-upgrade
# zsh completion for helm-upgrade.
#
# Install (either works):
#   1. Copy onto $fpath as `_helm-upgrade` (done by `make install-completions`),
#      then ensure the directory is in fpath before compinit runs.
#   2. Source this file directly from .zshrc (after compinit).

_helm_upgrade_charts() {
  local f
  f="$(_helm_upgrade_config)"
  [[ -z "$f" ]] && return
  local -a charts
  charts=(${(f)"$(yq '.tiers[].charts[]' "$f" 2>/dev/null)"})
  _describe -t charts 'chart' charts
}

_helm_upgrade_namespaces() {
  local f
  f="$(_helm_upgrade_config)"
  [[ -z "$f" ]] && return
  local -a ns
  ns=(${(f)"$(yq '.namespace_overrides[]' "$f" 2>/dev/null | sort -u)"})
  _describe -t namespaces 'namespace' ns
}

_helm_upgrade_tiers() {
  local f
  f="$(_helm_upgrade_config)"
  [[ -z "$f" ]] && return
  local -a tiers
  tiers=(${(f)"$(yq '.tiers[].tier' "$f" 2>/dev/null)"})
  _describe -t tiers 'tier' tiers
}

# Walk up from $PWD to find .infra-config.yaml at the repo root.
_helm_upgrade_config() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.infra-config.yaml" ]]; then
      echo "$dir/.infra-config.yaml"
      return
    fi
    dir="$(dirname "$dir")"
  done
}

_helm-upgrade() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  _arguments -C \
    '(-n --namespace)'{-n,--namespace}'=[filter to namespace]:namespace:_helm_upgrade_namespaces' \
    '--env=[target environment]:env:(dev stage prod)' \
    '--stage[shorthand for --env stage]' \
    '--prod[shorthand for --env prod]' \
    '--dev[shorthand for --env dev]' \
    '--include=[comma-separated chart list]:charts:_helm_upgrade_charts' \
    '--exclude=[comma-separated chart list]:charts:_helm_upgrade_charts' \
    '--tiers=[comma-separated tier indices]:tiers:_helm_upgrade_tiers' \
    '(-i --interactive)'{-i,--interactive}'[interactive chart picker]' \
    '--preview[show manifest diff before upgrade]' \
    '--preview-tool=[diff viewer]:tool:(code kdiff3 opendiff meld terminal)' \
    '--force[force upgrade]' \
    '--force-conflicts[force with conflict resolution]' \
    '--dry-run[preview without executing]' \
    '--headless[suppress interactive prompts]' \
    '--config=[alternate k8-lib config file]:config:_files' \
    '-h[show help]' \
    '--help[show help]' \
    '1:chart:_helm_upgrade_charts' && ret=0

  return ret
}

# Dual-mode: autoloaded from fpath (#compdef) vs sourced from .zshrc.
if [[ "${funcstack[1]}" == "_helm-upgrade" ]]; then
  _helm-upgrade "$@"
elif (( ${+functions[compdef]} )); then
  compdef _helm-upgrade helm-upgrade
fi
